<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pkg_ManagerGUI.RoomAllocationController">

    <center>
        <HBox spacing="20.0" style="-fx-background-color: #B3D9FF;">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <!-- Students Table -->
            <VBox prefWidth="400" spacing="10.0" style="-fx-background-color: #B3D9FF;">
                <Label style="-fx-font-weight: bold;" text="Unassigned Students" />
                <TableView fx:id="studentsTable" prefHeight="300" style="-fx-background-color: #B3D9FF;">
                    <columns>
                        <TableColumn fx:id="colStudentId" prefWidth="80" text="ID" />
                        <TableColumn fx:id="colStudentName" prefWidth="120" text="Name" />
                        <TableColumn fx:id="colGender" prefWidth="80" text="Gender" />
                        <TableColumn fx:id="colRoomPreference" prefWidth="100" text="Preference" />
                    </columns>
                </TableView>
            </VBox>

            <!-- Available Rooms Table -->
            <VBox prefWidth="400" spacing="10.0" style="-fx-background-color: #B3D9FF;">
                <Label style="-fx-font-weight: bold;" text="Available Rooms" />
                <TableView fx:id="roomsTable" prefHeight="300" style="-fx-background-color: #B3D9FF;">
                    <columns>
                        <TableColumn fx:id="colRoomNumber" prefWidth="100" text="Room #" />
                        <TableColumn fx:id="colRoomType" prefWidth="80" text="Type" />
                        <TableColumn fx:id="colRoomGender" prefWidth="80" text="Gender" />
                        <TableColumn fx:id="colAvailableSlots" prefWidth="80" text="Available" />
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #B3D9FF;">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <Button onAction="#handleAllocateRoom" style="-fx-background-color: #FF3333; -fx-text-fill: white;" text="Allocate Room" />
            <!-- Cancel Button -->
            <Button onAction="#handleCancel" style="-fx-background-color: #FF3333; -fx-text-fill: white;" text="Cancel" />
        </HBox>
    </bottom>
</BorderPane>
