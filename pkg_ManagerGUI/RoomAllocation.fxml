<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pkg_ManagerGUI.RoomAllocationController"
            prefWidth="900.0" prefHeight="600.0"
            style="-fx-background-color: #B3D9FF;">

    <children>

        <!-- Page Title -->
        <Label text="Room Allocation"
               layoutX="30.0" layoutY="20.0"
               style="-fx-font-size: 24px; -fx-font-weight: bold;" />

        <!-- Students Table -->
        <VBox layoutX="30.0" layoutY="70.0" spacing="10.0" prefWidth="840.0">
            <Label text="Unassigned Students" style="-fx-font-weight: bold;" />
            <TableView fx:id="studentsTable" prefHeight="180.0">
                <columns>
                    <TableColumn fx:id="colStudentId" text="ID" prefWidth="100"/>
                    <TableColumn fx:id="colStudentName" text="Name" prefWidth="200"/>
                    <TableColumn fx:id="colGender" text="Gender" prefWidth="100"/>
                    <TableColumn fx:id="colRoomPreference" text="Preference" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Rooms Table -->
        <VBox layoutX="30.0" layoutY="280.0" spacing="10.0" prefWidth="840.0">
            <Label text="Available Rooms" style="-fx-font-weight: bold;" />
            <TableView fx:id="roomsTable" prefHeight="180.0">
                <columns>
                    <TableColumn fx:id="colRoomNumber" text="Room #" prefWidth="120"/>
                    <TableColumn fx:id="colRoomType" text="Type" prefWidth="120"/>
                    <TableColumn fx:id="colRoomGender" text="Gender" prefWidth="100"/>
                    <TableColumn fx:id="colAvailableSlots" text="Available" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Buttons Centered -->
        <HBox layoutX="350.0" layoutY="520.0" spacing="10.0" alignment="CENTER">
            <Button text="Allocate Room"
                    onAction="#handleAllocateRoom"
                    styleClass="manager-action-button" />
            <Button text="Cancel"
                    onAction="#handleCancel"
                    styleClass="manager-action-button" />
        </HBox>

    </children>
</AnchorPane>
