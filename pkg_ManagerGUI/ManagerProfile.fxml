<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pkg_ManagerGUI.ManagerProfileController"
            prefWidth="900" prefHeight="600">

   <center>
      <HBox spacing="0" HBox.hgrow="ALWAYS">

         <!-- Navigation Panel (Left Side) -->
         <VBox prefWidth="300" spacing="20" style="-fx-background-color: #cce6ff;" alignment="TOP_CENTER">
            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20;">
               <ImageView fitHeight="80" fitWidth="80" preserveRatio="true">
                  <image>
                     <Image url="@/pkg_Images/admin.png"/>
                  </image>
               </ImageView>
               <Label text="Manager Dashboard" style="-fx-font-size: 20px; -fx-font-family: 'Arial Black';"/>
            </VBox>

            <VBox spacing="15" alignment="TOP_CENTER" style="-fx-padding: 10;">
               <Button fx:id="btnDeleteStudent" text="Delete Student"
                       onAction="#handleDeleteStudent"
                       style="-fx-background-color: #ff4d4d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-font-size: 14px;"
                       maxWidth="220" prefHeight="40"/>

               <Button fx:id="btnAddRoom" text="Add Room"
                       onAction="#handleAddRoom"
                       style="-fx-background-color: #ff4d4d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-font-size: 14px;"
                       maxWidth="220" prefHeight="40"/>

               <Button fx:id="btnAllocateRoom" text="Allocate Room"
                       onAction="#handleAllocateRoom"
                       style="-fx-background-color: #ff4d4d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-font-size: 14px;"
                       maxWidth="220" prefHeight="40"/>

               <Button fx:id="btnDeleteRoom" text="Delete Room"
                       onAction="#handleDeleteRoom"
                       style="-fx-background-color: #ff4d4d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-font-size: 14px;"
                       maxWidth="220" prefHeight="40"/>

               <Button fx:id="btnRoomifyServices" text="Roomify Services"
                       onAction="#handleRoomifyServices"
                       style="-fx-background-color: #ff4d4d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-font-size: 14px;"
                       maxWidth="220" prefHeight="40"/>

               <Button text="Log Out"
                       onAction="#handleLogout"
                       style="-fx-background-color: #888; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;"
                       maxWidth="220" prefHeight="40"/>
            </VBox>
         </VBox>

         <!-- Image Panel (Right Side) -->
         <StackPane prefWidth="600" HBox.hgrow="ALWAYS">
            <ImageView fitHeight="600" fitWidth="600" preserveRatio="true" smooth="true" pickOnBounds="true">
               <image>
                  <Image url="@/pkg_Images/sincerely-media-QK5_cFjNF0g-unsplash.jpg"/>
               </image>
            </ImageView>
         </StackPane>

      </HBox>
   </center>
</BorderPane>
