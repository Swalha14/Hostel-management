<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1"
            fx:controller="pkg_ManagerGUI.ManagerProfileController"
            prefHeight="400.0" prefWidth="600.0">

   <children>

      <!-- Right image panel -->
      <AnchorPane layoutX="249.0" prefWidth="351.0" prefHeight="400.0">
         <ImageView fitWidth="351.0" fitHeight="400.0" pickOnBounds="true">
            <image>
               <Image url="@/pkg_Images/sincerely-media-QK5_cFjNF0g-unsplash.jpg" />
            </image>
         </ImageView>
      </AnchorPane>

      <!-- Navigation panel -->
      <AnchorPane prefWidth="249.0" prefHeight="400.0" style="-fx-background-color: #B3D9FF;">
         <children>

            <!-- Header -->
            <AnchorPane prefHeight="57.0" prefWidth="249.0" style="-fx-background-color: #B3D9FF;">
               <ImageView fitHeight="61.0" fitWidth="83.0" layoutY="-1.0" preserveRatio="true">
                  <image>
                     <Image url="@/pkg_Images/admin.png" />
                  </image>
               </ImageView>
               <Label layoutX="83.0" layoutY="14.0" prefHeight="42.0" prefWidth="159.0" text="Navigation Bar">
                  <font>
                     <Font name="Arial Black" size="18.0" />
                  </font>
               </Label>
            </AnchorPane>

            <!-- Delete Student -->
            <Button fx:id="btnDeleteStudent" layoutX="11.0" layoutY="120.0"
                    onAction="#handleDeleteStudent"
                    prefHeight="28.0" prefWidth="215.0"
                    style="-fx-background-color: #FF0000;" text="Delete Student" />

            <!-- Add Room -->
            <Button fx:id="btnAddRoom" layoutX="11.0" layoutY="160.0"
                    onAction="#handleAddRoom"
                    prefHeight="28.0" prefWidth="215.0"
                    style="-fx-background-color: #FF0000;" text="Add Room" />

            <!-- Allocate Room -->
            <Button fx:id="btnAllocateRoom" layoutX="11.0" layoutY="200.0"
                    onAction="#handleAllocateRoom"
                    prefHeight="28.0" prefWidth="215.0"
                    style="-fx-background-color: #FF0000;" text="Allocate Room" />

            <!-- Delete Room -->
            <Button fx:id="btnDeleteRoom" layoutX="11.0" layoutY="240.0"
                    onAction="#handleDeleteRoom"
                    prefHeight="28.0" prefWidth="215.0"
                    style="-fx-background-color: #FF0000;" text="Delete Room" />

            <!-- Roomify Services -->
            <Button fx:id="btnRoomifyServices" layoutX="11.0" layoutY="280.0"
                    onAction="#handleRoomifyServices"
                    prefHeight="28.0" prefWidth="215.0"
                    style="-fx-background-color: #FF0000;" text="Roomify Services" />

            <!-- Logout -->
            <Button layoutX="11.0" layoutY="358.0"
                    onAction="#handleLogout"
                    prefHeight="28.0" prefWidth="215.0"
                    style="-fx-background-color: #FF0000;" text="Log Out" />

         </children>
      </AnchorPane>
   </children>
</AnchorPane>
