<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="pkg_ManagerGUI.DeleteRoomController"
            stylesheets="@deleteRoom.css"
            style="-fx-background-color: #f4faff;">

    <top>
        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #ff4d4d; -fx-padding: 20;">
            <Label text="Delete Room" textFill="white">
                <font>
                    <Font name="Arial Black" size="24"/>
                </font>
            </Label>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 40;">
            <Label text="Enter Room Number to Delete:"/>
            <TextField fx:id="roomNumberField" promptText="e.g. A101" maxWidth="250"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
            <Button text="Delete Room" onAction="#handleDeleteRoom" styleClass="delete-btn"/>
            <Button text="Cancel" onAction="#handleCancel" styleClass="cancel-btn"/>
            <Button text="Back to Dashboard" onAction="#handleBack" styleClass="back-btn"/>
        </HBox>
    </bottom>
</BorderPane>
