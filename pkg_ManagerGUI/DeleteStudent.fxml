<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="pkg_ManagerGUI.DeleteStudentController"
            prefWidth="900.0" prefHeight="600.0"
            style="-fx-background-color: #B3D9FF;">

    <children>

        <!-- Page Title -->
        <Label text="Delete Student"
               layoutX="30.0" layoutY="20.0"
               style="-fx-font-size: 24px; -fx-font-weight: bold;" />

        <!-- Students Table -->
        <VBox layoutX="30.0" layoutY="70.0" spacing="10.0" prefWidth="840.0">
            <Label text="All Students" style="-fx-font-weight: bold;" />
            <TableView fx:id="tableStudents" prefHeight="300.0">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="150"/>
                    <TableColumn fx:id="colName" text="Name" prefWidth="250"/>
                    <TableColumn fx:id="colGender" text="Gender" prefWidth="150"/>
                    <TableColumn fx:id="colPreference" text="Room Preference" prefWidth="200"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Input and Buttons Section -->
        <VBox layoutX="30.0" layoutY="390.0" spacing="15.0" prefWidth="840.0">
            <TextField fx:id="txtStudentID"
                       promptText="Enter Student ID to delete"
                       prefWidth="300"
                       style="-fx-font-size: 14px;" />

            <HBox spacing="15.0">
                <Button fx:id="btnDelete" text="Delete"
                        onAction="#handleDeleteStudent"
                        styleClass="red-button" prefWidth="100" />
                <Button text="Cancel"
                        onAction="#handleCancel"
                        styleClass="grey-button" prefWidth="100" />
            </HBox>

            <Label fx:id="lblMessage" />
        </VBox>

    </children>
</AnchorPane>
