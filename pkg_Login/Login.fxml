<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pkg_Login.LoginController"
            prefWidth="900" prefHeight="600">

   <!-- CENTER: Main Content -->
   <center>
      <HBox spacing="0">

         <!-- Left Image Panel -->
         <VBox prefWidth="350" style="-fx-background-color: white;">
            <ImageView fitWidth="350" fitHeight="600" preserveRatio="false" VBox.vgrow="ALWAYS">
               <image>
                  <Image url="@/pkg_Images/samuel-sng-uTf5s93aHps-unsplash.jpg"/>
               </image>
            </ImageView>
         </VBox>

         <!-- Right Login Form Panel -->
         <VBox spacing="20"
               alignment="TOP_CENTER"
               prefWidth="550"
               style="-fx-background-color: #F9F9F9; -fx-padding: 40 40 50 40; -fx-border-radius: 15; -fx-background-radius: 15;">

            <!-- Header -->
            <VBox alignment="CENTER" spacing="10"
                  style="-fx-background-color: #cce6ff; -fx-padding: 20; -fx-background-radius: 10;">
               <HBox alignment="CENTER" spacing="10">
                  <Label text="Roomify Login"
                         style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-font-family: 'Georgia';"/>
                  <ImageView fitWidth="32" fitHeight="32">
                     <image>
                        <Image url="@/pkg_Images/mobile-password-forgot.png"/>
                     </image>
                  </ImageView>
               </HBox>
               <Label text="Welcome back! Please login to your account"
                      style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
            </VBox>

            <!-- Form Fields -->
            <VBox spacing="15" alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
               <Label text="Username" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #34495e;"/>
               <TextField fx:id="txtUsername" promptText="Enter username" prefWidth="300" styleClass="login-textfield"/>

               <Label text="Password" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #34495e;"/>
               <PasswordField fx:id="txtPassword" promptText="Enter password" prefWidth="300" styleClass="login-passwordfield"/>

               <!-- Buttons Centered -->
               <HBox spacing="20" alignment="CENTER">
                  <Button fx:id="LoginButton"
                          text="Login"
                          onAction="#ActionLogin"
                          styleClass="login-button"
                          prefWidth="130"/>
                  <Button fx:id="CancelButton"
                          text="Cancel"
                          onAction="#ActionCancel"
                          styleClass="login-button"
                          prefWidth="130"/>
               </HBox>
            </VBox>

         </VBox>
      </HBox>
   </center>

   <!--  BOTTOM: Footer -->
   <bottom>
      <HBox alignment="CENTER" style="-fx-padding: 10;">
         <Label text="© 2025 Roomify. All rights reserved."
                alignment="CENTER"
                style="-fx-font-size: 12px; -fx-text-fill: #999999;"/>
      </HBox>
   </bottom>
</BorderPane>
