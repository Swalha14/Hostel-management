<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pkg_Welcome.WelcomeController"
            prefWidth="900" prefHeight="600">

   <center>
      <HBox spacing="0">

         <!-- Left Panel -->
         <VBox fx:id="leftPanel" prefWidth="350" style="-fx-background-color: white;">
            <ImageView fx:id="imageView"
                       fitWidth="350"
                       fitHeight="600"
                       preserveRatio="true">
               <image>
                  <Image url="@/pkg_Images/malcolm-shadrach-_r80LCluvVM-unsplash.jpg"/>
               </image>
            </ImageView>
         </VBox>

         <!-- Right Panel -->
         <VBox fx:id="rightPanel"
               prefWidth="550"
               spacing="20"
               alignment="TOP_CENTER"
               style="-fx-background-color: #F9F9F9; -fx-padding: 30; -fx-border-radius: 15; -fx-background-radius: 15;">

            <!-- Top Header Section: Roomify + Tagline -->
            <VBox alignment="CENTER" spacing="5"
                  style="-fx-background-color: #cce6ff; -fx-padding: 15; -fx-background-radius: 10;">
               <HBox alignment="CENTER" spacing="10">
                  <Label text="Roomify"
                         style="-fx-font-size: 34px; -fx-font-family: 'Georgia'; -fx-font-weight: bold;"/>
                  <ImageView fitWidth="40" fitHeight="40">
                     <image>
                        <Image url="@/pkg_Images/key.png"/>
                     </image>
                  </ImageView>
               </HBox>
               <Label text="A home away from home"
                      style="-fx-font-size: 16px; -fx-font-family: 'Georgia'; -fx-text-fill: #2c3e50;"/>
            </VBox>

            <!-- Middle Section -->
            <VBox alignment="CENTER" spacing="25" VBox.vgrow="ALWAYS">

               <Label text="Log in to your Roomify Account"
                      style="-fx-font-size: 22px; -fx-font-family: 'Calibri'; -fx-font-weight: bold;"/>

               <Button fx:id="btnLogin"
                       text="Login"
                       onAction="#handleLogin"
                       style="-fx-background-color: #00C896; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 10;"
                       prefWidth="220" prefHeight="40"/>

               <Label text="Don't have an account? Sign Up now"
                      style="-fx-font-size: 16px; -fx-font-family: 'Calibri'; -fx-text-fill: #666666;"/>

               <Button fx:id="btnSignUp"
                       text="Sign Up"
                       onAction="#handleSignUp"
                       style="-fx-background-color: #3399FF; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 10;"
                       prefWidth="220" prefHeight="40"/>
            </VBox>

            <!-- Footer Section -->
            <Label text="© 2025 Roomify. All rights reserved."
                   alignment="CENTER"
                   style="-fx-font-size: 12px; -fx-text-fill: #999999;"/>
         </VBox>
      </HBox>
   </center>
</BorderPane>