<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pkg_SignUp.SignUpController"
            prefWidth="900" prefHeight="600">

   <center>
      <HBox spacing="0">

         <!-- Left Image Panel -->
         <VBox prefWidth="350" style="-fx-background-color: white;">
            <ImageView fitWidth="350" fitHeight="600" preserveRatio="false">
               <image>
                  <Image url="@/pkg_Images/lee-wisener-67NO6wiwRgA-unsplash.jpg"/>
               </image>
            </ImageView>
         </VBox>

         <!-- Right Form Panel -->
         <VBox spacing="20"
               alignment="TOP_CENTER"
               prefWidth="550"
               style="-fx-background-color: #F9F9F9; -fx-padding: 30 30 50 30; -fx-border-radius: 15; -fx-background-radius: 15;">

            <!-- Header -->
            <VBox alignment="CENTER" spacing="5"
                  style="-fx-background-color: #cce6ff; -fx-padding: 15; -fx-background-radius: 10;">
               <HBox alignment="CENTER" spacing="10">
                  <Label text="Roomify Sign Up"
                         style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-font-family: 'Georgia';"/>
                  <ImageView fitWidth="32" fitHeight="32">
                     <image>
                        <Image url="@/pkg_Images/enrollment.png"/>
                     </image>
                  </ImageView>
               </HBox>
               <Label text="Create your account to get started"
                      style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
            </VBox>

            <!-- Form Fields -->
            <VBox spacing="15" alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
               <TextField fx:id="txtName" promptText="Full Name" prefWidth="250"/>
               <TextField fx:id="txtEmail" promptText="Email" prefWidth="250"/>
               <TextField fx:id="txtUsername" promptText="Username" prefWidth="250"/>
               <TextField fx:id="txtStudentID" promptText="Student ID" prefWidth="250"/>
               <PasswordField fx:id="txtPassword" promptText="Password" prefWidth="250"/>
               <PasswordField fx:id="txtConfirmPassword" promptText="Confirm Password" prefWidth="250"/>
               <ComboBox fx:id="comboGender" prefWidth="250" promptText="Select Gender"/>
               <ComboBox fx:id="comboRoomType" prefWidth="250" promptText="Room Preference"/>
            </VBox>

            <!-- Buttons at Bottom -->
            <HBox spacing="20" alignment="CENTER_RIGHT">
               <Button fx:id="btnCancel"
                       text="Cancel"
                       onAction="#handleCancel"
                       styleClass="button"
                       prefWidth="110"/>
               <Button fx:id="btnRegister"
                       text="Sign Up"
                       onAction="#handleRegister"
                       styleClass="button"
                       prefWidth="110"/>
            </HBox>

            <!-- Footer -->
            <Label text="© 2025 Roomify. All rights reserved."
                   style="-fx-font-size: 12px; -fx-text-fill: #999999;"/>
         </VBox>
      </HBox>
   </center>
</BorderPane>
