<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<AnchorPane prefWidth="900.0" prefHeight="600.0" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pkg_StudentGUI.StudentProfileController">

   <children>

      <!-- Left Navigation Panel -->
      <AnchorPane prefWidth="250.0" style="-fx-background-color: #B3D9FF;" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0">
         <VBox alignment="TOP_CENTER" spacing="20" AnchorPane.topAnchor="20.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <!-- Top Section -->
            <HBox alignment="CENTER" spacing="10">
               <ImageView fitHeight="48.0" fitWidth="48.0" preserveRatio="true">
                  <image>
                     <Image url="@/pkg_Images/business-man.png"/>
                  </image>
               </ImageView>
               <Label text="Navigation Bar">
                  <font>
                     <Font name="Arial Black" size="18.0"/>
                  </font>
               </Label>
            </HBox>

            <!-- Buttons -->
            <VBox spacing="60" alignment="TOP_CENTER">
               <Button fx:id="btnViewProfile" text="View Profile" onAction="#handleViewProfile" styleClass="button" prefWidth="180"/>
               <Button fx:id="btnViewRoomDetails" text="View Room Details" styleClass="button" prefWidth="180"/>
               <Button fx:id="btnViewServices" text="View Services" onAction="#handleViewServices" styleClass="button" prefWidth="180"/>
               <Button fx:id="btnLogout" text="Log Out" onAction="#handleLogout" styleClass="button" prefWidth="180"/>
            </VBox>
         </VBox>
      </AnchorPane>

      <!-- Right StackPane to Hold Content -->
      <StackPane layoutX="250.0" layoutY="0.0" prefWidth="650.0" prefHeight="600.0" AnchorPane.leftAnchor="250.0">
         <children>
            <ImageView fitHeight="600.0" fitWidth="650.0" preserveRatio="false">
               <image>
                  <Image url="@/pkg_Images/steven-ungermann-aRT5UCf2MYY-unsplash.jpg"/>
               </image>
            </ImageView>

            <!-- Profile Pane (Now with Cards) -->
            <AnchorPane fx:id="ProfilePane" visible="false" style="-fx-background-color: rgba(255,255,255,0.85);" prefWidth="600.0" prefHeight="400.0">
               <children>
                  <VBox spacing="15" layoutX="50.0" layoutY="50.0">
                     <AnchorPane styleClass="profile-card pastel-blue">
                        <VBox spacing="5">
                           <Label text="Name:" styleClass="card-label"/>
                           <Label fx:id="txtName" text="John Doe" styleClass="card-value"/>
                        </VBox>
                     </AnchorPane>
                     <AnchorPane styleClass="profile-card pastel-pink">
                        <VBox spacing="5">
                           <Label text="Username:" styleClass="card-label"/>
                           <Label fx:id="txtUsername" text="johndoe" styleClass="card-value"/>
                        </VBox>
                     </AnchorPane>
                     <AnchorPane styleClass="profile-card pastel-green">
                        <VBox spacing="5">
                           <Label text="Email:" styleClass="card-label"/>
                           <Label fx:id="txtEmail" text="john@example.com" styleClass="card-value"/>
                        </VBox>
                     </AnchorPane>
                     <AnchorPane styleClass="profile-card pastel-yellow">
                        <VBox spacing="5">
                           <Label text="Student ID:" styleClass="card-label"/>
                           <Label fx:id="txtStudentID" text="ST12345" styleClass="card-value"/>
                        </VBox>
                     </AnchorPane>
                  </VBox>
               </children>
            </AnchorPane>

            <!-- Room Details Pane -->
            <AnchorPane fx:id="RoomDetailsPane" visible="false" style="-fx-background-color: rgba(255,255,255,0.85);" prefWidth="600.0" prefHeight="400.0">
               <!-- You can add content here -->
            </AnchorPane>

            <!-- Services Pane -->
            <AnchorPane fx:id="ServicesPane" visible="false" style="-fx-background-color: rgba(255,255,255,0.85);" prefWidth="600.0" prefHeight="400.0">
               <children>
                  <VBox fx:id="servicesContainer" spacing="15">
                     <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                     </padding>
                     <!-- Service cards will be added dynamically in the controller -->
                  </VBox>
               </children>
            </AnchorPane>

         </children>
      </StackPane>

   </children>
</AnchorPane>
